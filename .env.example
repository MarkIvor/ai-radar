# ============================================================
# AI Radar — example environment file
# Копируйте в `.env` и подставьте свои значения.
# .env НИКОГДА не коммитится в репозиторий.
# ============================================================

# --- Безопасность ---
# Мастер-пароль для входа в UI (по умолчанию).
MASTER_PASSWORD=airadar
# Секрет для подписи JWT. Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please-32-bytes-of-randomness
# Срок жизни access-токена в минутах (для UI-сессии).
ACCESS_TOKEN_TTL_MIN=30
# Срок жизни refresh-токена в днях.
REFRESH_TOKEN_TTL_DAYS=7

# --- Хранилище ---
# Путь к файлу SQLite. Относительно корня проекта.
DATABASE_PATH=storage/airadar.db

# --- AI Judge (Сигнал 2) ---
# Режим суда: "ensemble" (несколько моделей голосуют) или "single" (одна активная модель).
JUDGE_MODE=ensemble
# Таймаут HTTP-вызова к LLM в секундах.
JUDGE_HTTP_TIMEOUT_SEC=60
# Порог активации БЛОКИРУЮЩЕГО ВЕТО в процентах [50..95].
VETO_THRESHOLD=75
# Число retry-попыток при невалидном JSON-ответе LLM.
JUDGE_MAX_RETRIES=2

# --- UI ---
# Включить /docs и /redoc в проде (true / false).
DOCS_ENABLED=true

# ВАЖНО: список LLM-провайдеров (base_url, model, api_key) настраивается
# через Admin-панель UI или через API /api/admin/llm-providers и хранится
# в SQLite. В .env достаточно только базовой конфигурации выше.
#
# Пресет по умолчанию можно добавить через переменные (необязательно):
# DEFAULT_LLM_BASE_URL=https://api.example.com/v1
# DEFAULT_LLM_MODEL=openai/gpt-5.1
# DEFAULT_LLM_API_KEY=
